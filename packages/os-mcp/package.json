{
  "name": "@tkawen/os-mcp",
  "version": "0.2.0",
  "description": "Read-only MCP server (stdio) exposing a TKAWEN OS academy's live catalogue, instructors, certificate verification and, with a token, the learner's own dashboard.",
  "license": "MIT",
  "author": "TKAWEN",
  "type": "module",
  "bin": {
    "tkawen-os-mcp": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js",
    "prepublishOnly": "node scripts/check-publishable.mjs && npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tkawen",
    "tkawen-os",
    "lms",
    "claude"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@tkawen/os-sdk": "^0.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tkawen/developer-platform.git",
    "directory": "packages/os-mcp"
  },
  "homepage": "https://github.com/tkawen/developer-platform/tree/main/packages/os-mcp#readme",
  "bugs": {
    "url": "https://github.com/tkawen/developer-platform/issues"
  },
  "mcpName": "io.github.tkawen/os-mcp"
}
